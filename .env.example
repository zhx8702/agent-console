# DEVELOPMENT TEMPLATE ONLY.
# Administrative secrets are intentionally blank. The provided launch scripts
# generate independent high-entropy local values; direct Compose users must set
# the three COMPOSE_ADMIN_*/COMPOSE_MEDIA_* values before starting the app.
# Build a separate production env file from docs/production-deployment.md.

APP_ENV=dev
# Optional dev/test opt-in. Production-like APP_ENV values are always strict.
AGENT_CONSOLE_STRICT_CONFIG=false
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=agent-console
APP_PROCESS_ROLE=api
PLUGIN_INSTALL_DIR=.runtime/plugins
PLUGIN_DYNAMIC_MUTATIONS_ENABLED=true
SCHEDULER_LEASE_KEY=agent-console:scheduler:leader
SCHEDULER_LEASE_TTL_SECONDS=30
SCHEDULER_LEASE_ACQUIRE_TIMEOUT_SECONDS=30
SCHEDULER_LEASE_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_KEY_PREFIX=agent-console:worker:heartbeat
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=20
# Standalone workers keep their HTTP metrics endpoint off by default. The
# Compose contract overrides these with 0.0.0.0:9100 on its private network.
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=0
# Comma-separated roles API readiness must observe in Redis.
READINESS_REQUIRED_WORKER_ROLES=

# Postgres
DB_DSN=postgresql+asyncpg://cs:cs@localhost:5432/cs
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Never enable outside isolated dev/test databases; production schema is Alembic-only.

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
OPENAI_DISABLE_FALLBACK=false
OPENAI_WEB_SEARCH_ENABLED=false
OPENAI_WEB_SEARCH_TOOL=web_search
OPENAI_WEB_SEARCH_LIVE_ENABLED=true
LLM_EMBED_PROVIDER=fake
CUSTOMER_SERVICE_PROMPT_ENABLED=true
LLM_MODEL_TIER1=gpt-5.5
LLM_MODEL_TIER2=gpt-5.5
LLM_MODEL_TIER3=gpt-5.5
LLM_EMBED_MODEL=voyage-3
TENANT_DEFAULT_DAILY_TOKENS=1000000
PERSONA_EXTRACT_STAGE_TIMEOUT_SECONDS=120
PERSONA_EXTRACT_STAGE_MAX_RETRIES=0
PERSONA_EXTRACT_JOB_MAX_ATTEMPTS=3
PERSONA_EXTRACT_JOB_RETRY_BACKOFF_SECONDS=30
PERSONA_EXTRACT_JOB_LEASE_SECONDS=180
PERSONA_EXTRACT_JOB_HEARTBEAT_SECONDS=30
PERSONA_EXTRACT_JOB_POLL_INTERVAL_SECONDS=2
PERSONA_EXTRACT_WORKER_ROLES=scheduler
PERSONA_EXTRACT_CHUNK_MAX_TOKENS=8000
PERSONA_EXTRACT_CHUNK_MAX_MESSAGES=400
PERSONA_EXTRACT_CHUNK_CONCURRENCY=3
ORCHESTRATOR_HANDLE_TIMEOUT_SECONDS=150
ORCHESTRATOR_FLOW_RUNTIME_ENABLED=false
ORCHESTRATOR_FLOW_RUNTIME_NAME=default_compatible_flow
ORCHESTRATOR_FLOW_RUNTIME_ALLOWED_NAMES=default_compatible_flow
ORCHESTRATOR_FLOW_RUNTIME_ALLOW_TARGET_FLOWS=false
ORCHESTRATOR_FLOW_RUNTIME_ALLOW_COMPATIBLE_FALLBACK=false
ORCHESTRATOR_FLOW_EFFECT_COMMIT_BACKEND=none
ORCHESTRATOR_FLOW_EFFECT_HANDLERS_ENABLED=false
ORCHESTRATOR_FLOW_EFFECT_HANDLER_ALLOWLIST=
ORCHESTRATOR_FLOW_EFFECT_LOG_BACKEND=none
ORCHESTRATOR_FLOW_EFFECT_LOG_FAILURE_POLICY=fail_closed
ORCHESTRATOR_FLOW_SHADOW_ENABLED=false
ORCHESTRATOR_FLOW_SHADOW_NAME=default_compatible_flow
ORCHESTRATOR_FLOW_SHADOW_MODE=noop
ORCHESTRATOR_FLOW_SHADOW_CORE_PREVIEW_ENABLED=false
ORCHESTRATOR_FLOW_SHADOW_PLUGIN_DRY_RUN_ENABLED=false
ORCHESTRATOR_FLOW_SHADOW_EFFECT_DRY_RUN_ENABLED=false
MEMORY_LLM_EXTRACTION_ENABLED=false
MEMORY_LLM_EXTRACTION_TIMEOUT_SECONDS=1.0
MEMORY_LLM_EXTRACTION_MAX_ACTIONS=4
MEMORY_LLM_EXTRACTION_MIN_CONFIDENCE=0.75
MEMORY_ACCEPTANCE_AUTO_ACCEPT_MIN=0.78
MEMORY_ACCEPTANCE_REJECT_BELOW=0.35
MEMORY_LLM_EXTRACTION_JOB_ENABLED=true
MEMORY_LLM_EXTRACTION_JOB_DRAIN_ENABLED=false
MEMORY_LLM_EXTRACTION_JOB_SCOPE_ALLOWLIST=
MEMORY_LLM_EXTRACTION_JOB_DRAIN_BATCH_SIZE=5
MEMORY_LLM_EXTRACTION_JOB_DRAIN_MAX_CLAIMS=0
MEMORY_LLM_EXTRACTION_JOB_MAX_ATTEMPTS=3
MEMORY_LLM_EXTRACTION_JOB_BACKOFF_SECONDS=30.0
MEMORY_LLM_EXTRACTION_JOB_TIMEOUT_SECONDS=5.0
MEMORY_LLM_EXTRACTION_JOB_LOCK_TTL_SECONDS=60.0
MEMORY_LLM_EXTRACTION_JOB_DRAIN_INTERVAL_SECONDS=5.0
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_HYBRID_RETRIEVAL_ENABLED=false
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_RETRIEVAL_BUDGET_CHARS=1600
MEMORY_VECTOR_INDEX_ENABLED=false
MEMORY_VECTOR_COLLECTION=agent_console_memory_items
# Privacy-safe default: private/identity-wide memories are not loaded into or
# learned from group chats. Enable only with an explicit member consent flow.
MEMORY_GROUP_IDENTITY_MEMORY_ENABLED=false
MEMORY_VECTOR_SIZE=64
MEMORY_VECTOR_EMBED_MODEL=
MEMORY_VECTOR_TIMEOUT_SECONDS=2.0
MEMORY_VECTOR_TOP_K=12
MEMORY_GRAPH_VECTOR_TOP_K=12
MEMORY_VECTOR_INDEX_STRICT_STARTUP_CHECK=false
MEMORY_GRAPH_RETRIEVAL_ENABLED=false
MEMORY_GRAPH_RETRIEVAL_FACT_TOP_K=3
MEMORY_GRAPH_RETRIEVAL_EPISODE_TOP_K=2
MEMORY_GRAPH_RETRIEVAL_BUDGET_CHARS=600
# Runtime app setting for non-Compose launches; Docker Compose uses COMPOSE_* flags below.
MEMORY_GRAPH_LLM_EXTRACTION_ENABLED=false
MEMORY_GRAPH_LLM_EXTRACTION_TIMEOUT_SECONDS=1.0
MEMORY_GRAPH_LLM_EXTRACTION_MAX_ACTIONS=16
MEMORY_GRAPH_LLM_EXTRACTION_MAX_ENTITIES=8
MEMORY_GRAPH_LLM_EXTRACTION_MAX_FACTS=4
MEMORY_GRAPH_LLM_EXTRACTION_MAX_EPISODES=2
MEMORY_GRAPH_LLM_EXTRACTION_MIN_CONFIDENCE=0.8
MEMORY_GOVERNANCE_AUTO_CLEANUP_ENABLED=true
MEMORY_GOVERNANCE_INTERVAL_SECONDS=86400
MEMORY_NEEDS_REVIEW_RETENTION_DAYS=30
MEMORY_REJECTED_RETENTION_DAYS=7
MEMORY_AUTO_EXPIRE_DAYS=180
MEMORY_GOVERNANCE_BATCH_SIZE=500
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
AGENT_REQUIRED_WEB_SEARCH_TIMEOUT_SECONDS=90
AGENT_REQUIRED_WEB_SEARCH_MAX_OUTPUT_TOKENS=2400
AGENT_REQUIRED_WEB_SEARCH_MAX_ATTEMPTS=2

# Ingress
INBOUND_SIGNATURE_WINDOW_SECONDS=300
INBOUND_MAX_BODY_BYTES=1048576
INBOUND_IDEMPOTENCY_TTL_SECONDS=86400
INBOUND_DEFAULT_RATE_LIMIT=50
# Optional JSON object keyed by tenant ID. Once configured, tenants missing an
# explicit entry fail closed instead of falling back to TENANT_DEMO_SECRET.
TENANT_INBOUND_SECRETS={}

# Egress
OUTBOUND_WEBHOOK_URL=http://localhost:9999/deliver
OUTBOUND_HMAC_SECRET=change_me
OUTBOUND_MAX_RETRIES=5
OUTBOUND_TIMEOUT_SECONDS=10
OUTBOUND_TRANSPORT_MAX_ATTEMPTS=3
OUTBOUND_TRANSPORT_RETRY_BASE_SECONDS=0.2
OUTBOUND_TRANSPORT_RETRY_MAX_SECONDS=2
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_LEASE_SECONDS=30
OUTBOX_RELAY_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_RELAY_MAX_ATTEMPTS=12
EFFECT_INTENT_RELAY_POLL_INTERVAL_SECONDS=0.5
EFFECT_INTENT_RELAY_BATCH_SIZE=32
EFFECT_INTENT_RELAY_LEASE_SECONDS=30
EFFECT_INTENT_RELAY_HANDLER_TIMEOUT_SECONDS=20
EFFECT_INTENT_RELAY_MAX_ATTEMPTS=12
INBOX_PROCESSING_LEASE_SECONDS=180
# Optional JSON objects keyed by tenant ID. If either outbound map is non-empty,
# an unknown tenant or a tenant missing either value fails closed.
TENANT_OUTBOUND_WEBHOOK_URLS={}
TENANT_OUTBOUND_HMAC_SECRETS={}
ADMIN_BEARER_TOKEN=
ADMIN_SESSION_SIGNING_SECRET=
MEDIA_ID_SIGNING_SECRET=
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_COOKIE_NAME=agent_console_admin_session
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_ALLOW_BEARER_FALLBACK=true

# Wxbot bridge
# Optional compatibility credential for SDK builds that enable HTTP API auth.
WXBOT_API_TOKEN=
# Optional: bind a connector worker to a control-plane connection. Leave empty
# for the one-release legacy WXBOT_* compatibility connection.
CHANNEL_CONNECTION_ID=
# Additional deployment-approved connector origins, comma-separated. The
# WXBOT_SDK_URL origin is approved automatically.
CHANNEL_ALLOWED_SDK_ORIGINS=
WXBOT_AUTH_SERVER_URL=
WXBOT_AUTH_ADMIN_KEY=
WXBOT_SDK_URL=http://127.0.0.1:5080
WXBOT_DEFAULT_TENANT_ID=default
WXBOT_BRIDGE_POLL_INTERVAL=3
WXBOT_BRIDGE_SEND_INTERVAL=2
WXBOT_BRIDGE_MAX_MESSAGE_AGE_SECONDS=1800
# Emergency compatibility only; keep false so public social policy fails closed.
SOCIAL_POLICY_LEGACY_WXBOT_FALLBACK_ENABLED=false
WXBOT_GROUP_CONTEXT_ENABLED=true
WXBOT_GROUP_CONTEXT_RECENT_LIMIT=80
WXBOT_GROUP_CONTEXT_BUDGET_CHARS=6000
WXBOT_GROUP_SUMMARY_ENABLED=true
WXBOT_GROUP_SUMMARY_ONLY_WHEN_ADDRESSED=true
WXBOT_GROUP_SUMMARY_DEBOUNCE_SECONDS=20
WXBOT_GROUP_SUMMARY_DRAIN_INTERVAL_SECONDS=2
WXBOT_GROUP_SUMMARY_BATCH_SIZE=80
WXBOT_GROUP_SUMMARY_INPUT_BUDGET_CHARS=12000
WXBOT_GROUP_SUMMARY_OBSERVATION_MAX_CHARS=800
WXBOT_GROUP_SUMMARY_OLD_SUMMARY_MAX_CHARS=2000
WXBOT_GROUP_SUMMARY_MAX_OUTPUT_TOKENS=600
WXBOT_GROUP_SUMMARY_MAX_CHARS=2500
WXBOT_GROUP_SUMMARY_TIMEOUT_SECONDS=90
WXBOT_GROUP_SUMMARY_LOCK_TTL_SECONDS=180
WXBOT_GROUP_SUMMARY_RETRY_BACKOFF_SECONDS=15
WXBOT_GROUP_OBSERVATION_RETENTION_DAYS=30
WXBOT_GROUP_OBSERVATION_PRUNE_INTERVAL_SECONDS=3600
WXBOT_PREVIEW_WAIT_SECONDS=30
WXBOT_PREVIEW_POLL_INTERVAL_SECONDS=0.7
WXBOT_MEDIA_BASE_URL=
# Max bytes the agent may load into a text inspection/conversion tool.
WXBOT_FILE_ANALYSIS_MAX_BYTES=8388608
WXBOT_PENDING_MEDIA_TTL_SECONDS=900
WXBOT_PENDING_MEDIA_MAX_ITEMS=1000
# Absolute path shared with the companion SDK container for generated files.
WXBOT_OUTBOUND_FILE_DIR=/data/wxbot-outbound
WXBOT_OUTBOUND_FILE_MAX_BYTES=10485760
WXBOT_OUTBOUND_FILE_RETENTION_SECONDS=604800
WXBOT_OUTBOUND_FILE_CLEANUP_GRACE_SECONDS=300
WXBOT_DAILY_REPORT_FOOTER=

# Optional organization-specific reset feed. It remains completely inert until
# explicitly enabled with an operator-supplied endpoint.
TIBO_RESET_ENABLED=false
TIBO_RESET_API_URL=
TIBO_RESET_POLL_INTERVAL_SECONDS=300
TIBO_RESET_REQUEST_TIMEOUT_SECONDS=15
TIBO_RESET_TIMEZONE=UTC

# Draw
DRAW_API_URL=
DRAW_API_EDIT_URL=
DRAW_API_KEY=
DRAW_API_MODEL=
DRAW_API_TIMEOUT_SECONDS=600
DRAW_API_EXTRA_BODY=
DRAW_FALLBACK_API_URL=
DRAW_FALLBACK_API_EDIT_URL=
DRAW_FALLBACK_API_KEY=
DRAW_FALLBACK_API_MODEL=
DRAW_FALLBACK_API_TIMEOUT_SECONDS=600
DRAW_FALLBACK_API_EXTRA_BODY=
DRAW_STORAGE_DIR=/data/draw

# AMap personal map
AMAP_API_KEY=
AMAP_API_TIMEOUT_SECONDS=30
AMAP_STORAGE_DIR=/data/amap
AMAP_SEARCH_CREDIT_COST=2
AMAP_MAP_CREDIT_COST=8
AMAP_ROUTE_MAP_CREDIT_COST=12

# Frontend / CORS
FRONTEND_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173

# Docker Compose deployment overrides
# Local-development database credentials. Production must use unique values in
# a separate env file and the docker-compose.production.yml overlay.
# Production only: keep the fixed project/volume namespace below in
# .env.production. Do not reuse a development volume name.
# COMPOSE_PROJECT_NAME=agent-console-prod
# COMPOSE_PROD_PGDATA_VOLUME=agent-console-prod-pgdata
# COMPOSE_PROD_REDISDATA_VOLUME=agent-console-prod-redisdata
# COMPOSE_PROD_QDRANTDATA_VOLUME=agent-console-prod-qdrantdata
