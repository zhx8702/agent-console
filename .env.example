COMPOSE_DRAW_FALLBACK_API_MODEL=
COMPOSE_DRAW_FALLBACK_API_TIMEOUT_SECONDS=600
COMPOSE_DRAW_FALLBACK_API_EXTRA_BODY=
COMPOSE_DRAW_STORAGE_DIR=/data/draw
COMPOSE_MODERATION_WEBHOOK_ALLOWED_HOSTS=qyapi.weixin.qq.com
COMPOSE_AMAP_API_KEY=
COMPOSE_AMAP_API_TIMEOUT_SECONDS=30
COMPOSE_AMAP_STORAGE_DIR=/data/amap
COMPOSE_AMAP_SEARCH_CREDIT_COST=2
COMPOSE_AMAP_MAP_CREDIT_COST=8
COMPOSE_AMAP_ROUTE_MAP_CREDIT_COST=12
COMPOSE_READINESS_REQUIRED_WORKER_ROLES=inbound,outbound,scheduler

# Host bindings. The API and frontend remain loopback-only by default.
COMPOSE_BIND_ADDRESS=127.0.0.1
COMPOSE_API_PORT=8000
COMPOSE_FRONTEND_PORT=4173

# Used only with docker-compose.dev.yml for host-side debugging tools. The
# override binds every stateful-service port to 127.0.0.1.
COMPOSE_DEV_POSTGRES_PORT=5432
COMPOSE_DEV_REDIS_PORT=6379
COMPOSE_DEV_QDRANT_HTTP_PORT=6333
COMPOSE_DEV_QDRANT_GRPC_PORT=6334
COMPOSE_DEV_OTEL_GRPC_PORT=4317
COMPOSE_DEV_OTEL_HTTP_PORT=4318

# Multi-tenant demo secret (in prod use a per-tenant secret store)
TENANT_DEMO_SECRET=demo_secret

# Redis Streams reliability. Pending claim idle must remain above the longest
# normal orchestration window to avoid concurrent processing of a live item.
BUS_MAX_ATTEMPTS=5
BUS_RETRY_BASE_SECONDS=1
BUS_RETRY_MAX_SECONDS=30
BUS_PENDING_CLAIM_IDLE_MS=300000

# Session
SESSION_WINDOW_TURNS=20
SESSION_TTL_SECONDS=1800
SESSION_LOCK_TTL_SECONDS=30

# Router
ROUTER_CONFIG_PATH=config/router.yaml

# Safety
SAFETY_KEYWORDS_PATH=config/safety_keywords.txt
MODERATION_WEBHOOK_ALLOWED_HOSTS=qyapi.weixin.qq.com

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
# Compose application processes export to the private collector by default.
COMPOSE_APP_SERVICE_NAME=agent-console
COMPOSE_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
COMPOSE_OTEL_EXPORTER_OTLP_INSECURE=true
COMPOSE_OTEL_TRACES_SAMPLER_ARG=1.0
