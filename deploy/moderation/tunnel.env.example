SSH_HOST=production.example.com
SSH_PORT=22
SSH_USER=moderation-tunnel
SSH_IDENTITY_FILE=/path/to/private/tunnel-key
SSH_KNOWN_HOSTS_FILE=/path/to/private/known_hosts
# Caddy runs on the production host, so the remote listener stays on loopback.
SSH_REMOTE_BIND=127.0.0.1
SSH_REMOTE_PORT=17436
MODERATION_LOCAL_HOST=127.0.0.1
MODERATION_LOCAL_PORT=11436
MODERATION_SUPERVISOR_PATH=/path/to/deploy/moderation/tunnel_supervisor.py
MODERATION_OLLAMA_URL=http://127.0.0.1:11436
MODERATION_MODELS=sileader/qwen3guard:0.6b,qwen3guard-precheck:latest
