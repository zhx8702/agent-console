# Match the source server version, then pin the verified image digest.
# Runtime versions can select different effective templates for the same model manifest.
OLLAMA_IMAGE=ollama/ollama:0.32.15
MODERATION_MODELS_DIR=./models
MODERATION_PORT=11436
MODERATION_MEMORY_LIMIT=4g
MODERATION_CPUS=2
MODERATION_PARALLEL=1
# Maximum distinct loaded models; aliases sharing a digest may be deduplicated.
MODERATION_MAX_LOADED_MODELS=2
MODERATION_MAX_QUEUE=16
MODERATION_KEEP_ALIVE=-1
# Host RAM cache, in MiB; 0 disables it. Requires a runtime supporting LLAMA_ARG_CACHE_RAM.
MODERATION_PROMPT_CACHE_MB=256
