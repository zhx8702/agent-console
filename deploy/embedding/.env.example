# Host paths are resolved relative to compose.yaml when they are not absolute.
# Prepare an independent Ollama models snapshot with the model below already pulled.
EMBEDDING_MODELS_DIR=./models
# Generate this private file before starting. Do not commit it.
EMBEDDING_TOKEN_PATH=./embedding.token
EMBEDDING_WORKER_PATH=./worker.py
EMBEDDING_PORT=11435

# This worker's warmup is validated for BGE-M3 tokenization.
# A different model requires warmup compatibility and recall acceptance checks.
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSIONS=1024

# Replace mutable tags with tested image digests for production.
OLLAMA_IMAGE=ollama/ollama:latest
PYTHON_IMAGE=python:3.11-slim
