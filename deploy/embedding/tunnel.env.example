# Paths and addresses are examples. Use absolute paths on the build machine.
SSH_HOST=production.example.com
SSH_PORT=22
SSH_USER=embedding-tunnel
SSH_IDENTITY_FILE=/path/to/private/tunnel-key
SSH_KNOWN_HOSTS_FILE=/path/to/private/known_hosts
# Use a production interface reachable from the app container, not a public listener.
SSH_REMOTE_BIND=172.17.0.1
SSH_REMOTE_PORT=17435
EMBEDDING_LOCAL_HOST=127.0.0.1
EMBEDDING_LOCAL_PORT=11435
